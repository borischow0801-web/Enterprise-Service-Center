# App
APP_ENV=development
# 仅为占位说明，不是可用的生产密钥。APP_ENV=production 时，若此值仍等于下面这段占位文本、
# 或为空、或长度不足32位，应用会在启动时直接报错退出（见 app/core/config.py）。
# 生产环境必须由部署环境显式注入一个稳定的高强度随机密钥（例如：openssl rand -base64 48），
# 不要在这里填真实密钥，也不要指望程序自动生成——容器重启后随机生成的密钥会导致所有已签发
# Token 全部失效。
APP_SECRET_KEY=change-me-in-production-very-long-secret-key

# Database
# 生产推荐直接使用 DATABASE_URL 指向独立 MySQL 8 服务器；留空时使用下方 DB_* 字段拼接。
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=enterprise_service_center
DB_ECHO=false

# JWT
JWT_ALGORITHM=HS256
JWT_ENTERPRISE_EXPIRE_MINUTES=720
JWT_ADMIN_EXPIRE_MINUTES=480
# 保留 480 分钟只是维持现有系统行为不变，与下方 BSPPLUS token 的有效期
# （文档标注默认 480 分钟）没有任何耦合关系——两者生命周期相互独立，本系统
# 从不读取、也不存储 BSPPLUS 的 token/refreshToken。

# BSPPLUS（浪潮政务服务基础服务）统一身份认证——管理端正式登录 POST /api/auth/admin/login
# 依赖这两项；开发环境留空时该接口会返回"统一身份认证服务未配置"，不影响 mock-login。
# 生产环境（APP_ENV=production）启动时会强制校验这两项已配置，未配置直接拒绝启动。
BSPPLUS_API_ROOT=
BSPPLUS_APP_CODE=
BSPPLUS_CONNECT_TIMEOUT_SECONDS=5
BSPPLUS_READ_TIMEOUT_SECONDS=10

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# CORS（生产环境按需配置，逗号分隔多个域名；留空时开发环境回退到本地/内网端口白名单）
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://h5.example.com
