# Image source. Do not use latest as the only production tag.
REGISTRY_HOST=registry.example.com
IMAGE_NAMESPACE=enterprise-center
IMAGE_TAG=1.0.0

# Runtime
APP_ENV=production
APP_SECRET_KEY=replace-with-output-of-openssl-rand-base64-48
UVICORN_WORKERS=2
TZ=Asia/Shanghai

# MySQL 8 on the independent database server. Prefer DATABASE_URL in production.
DATABASE_URL=mysql+pymysql://esc_app:REPLACE_PASSWORD@<DB_SERVER_IP>:3306/enterprise_service_center?charset=utf8mb4
# Legacy decomposed fields remain supported when DATABASE_URL is empty.
DB_HOST=<DB_SERVER_IP>
DB_PORT=3306
DB_USER=esc_app
DB_PASSWORD=REPLACE_PASSWORD
DB_NAME=enterprise_service_center
DB_ECHO=false

# JWT
JWT_ALGORITHM=HS256
JWT_ENTERPRISE_EXPIRE_MINUTES=720
JWT_ADMIN_EXPIRE_MINUTES=480

# BSPPLUS（浪潮政务服务基础服务）统一身份认证。管理端正式登录依赖这两项，
# APP_ENV=production 时启动会强制校验已配置（见 app/core/config.py），未配置直接拒绝启动。
# 地址/appCode 由政务网络/统一身份平台负责人下发，不要用示例值直接上生产。
BSPPLUS_API_ROOT=http://<BSPPLUS_HOST>:<BSPPLUS_PORT>
BSPPLUS_APP_CODE=<BSPPLUS_APP_CODE>
BSPPLUS_CONNECT_TIMEOUT_SECONDS=5
BSPPLUS_READ_TIMEOUT_SECONDS=10

# CORS. Same-origin Nginx deployment can leave this to the public site origin(s).
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Uploads. Container path must match UPLOAD_DIR; host path keeps files across rebuilds.
UPLOAD_DIR=/data/uploads
UPLOADS_HOST_DIR=/data/enterprise-center/uploads
MAX_UPLOAD_SIZE=10485760

# Nginx / Docker
HTTP_PORT=80
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
