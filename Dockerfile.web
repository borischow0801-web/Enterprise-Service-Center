# syntax=docker/dockerfile:1
FROM node:20-alpine AS admin-builder
WORKDIR /src/admin-web
COPY admin-web/package*.json ./
RUN npm ci
COPY admin-web/ ./
ARG ADMIN_BASE_PATH=/admin/
ARG API_BASE_URL=
ENV VITE_BASE_PATH=${ADMIN_BASE_PATH} \
    VITE_API_BASE_URL=${API_BASE_URL}
RUN npm run build

FROM node:20-alpine AS h5-builder
WORKDIR /src/enterprise-h5
COPY enterprise-h5/package*.json ./
RUN npm ci
COPY enterprise-h5/ ./
ARG H5_BASE_PATH=/
ARG API_BASE_URL=
ENV VITE_BASE_PATH=${H5_BASE_PATH} \
    VITE_API_BASE_URL=${API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=h5-builder /src/enterprise-h5/dist/ /usr/share/nginx/html/
COPY --from=admin-builder /src/admin-web/dist/ /usr/share/nginx/html/admin/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/api/health >/dev/null 2>&1 || exit 1
